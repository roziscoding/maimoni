# Local development (defaults already in mise.toml; set these only to override them)
# Postgres from compose.dev.yaml, published on localhost:5434 (see POSTGRES_PORT)
DATABASE_URL=postgres://maimoni:maimoni@localhost:5434/maimoni
# Backend
PORT=3001
# Frontend → backend proxy target
NUXT_API_BASE=http://localhost:3001
# Auth: dev values; production needs a real secret and the public URL
BETTER_AUTH_SECRET=maimoni-dev-secret-not-for-production
BETTER_AUTH_URL=http://localhost:3000
# Password reset emails go through Resend; without a key none are sent
# RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. maimoni <no-reply@example.com>
# RESEND_FROM=
# Optional sign in providers, each off unless all of its values are set (the bundle identifier and the iOS client ID are optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_IOS_CLIENT_ID=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# Contents of the key's .p8 file on one line, with \n for the line breaks
# APPLE_PRIVATE_KEY=
# APPLE_APP_BUNDLE_IDENTIFIER=
# Mobile app passkeys: the Android application ID and the SHA-256 fingerprints (comma-separated) of its signing certificates
# ANDROID_APP_PACKAGE=
# ANDROID_APP_CERT_SHA256=

# Production (compose.yaml): required, also used in the backend's DATABASE_URL, so URL-encode
# any of @ : / ? # in it
# POSTGRES_PASSWORD=
# Production (compose.yaml): required, password asked by Drizzle Gateway's UI
# DRIZZLE_GATEWAY_MASTERPASS=
